{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "taskflow template project",
  "homepage": "https://github.com/Ahmed-Abdelbarr/Task_Flow#readme",
  "scripts": {
    "build:dev": "webpack --progress",
    "build": "cross-env NODE_ENV=production webpack --env prod --progress",
    "build:web": "cross-env NODE_ENV=production webpack --env prod --progress",
    "publish:backend": "dotnet publish TaskFlow.csproj -c Release -o publish/backend --nologo -r win-x64 --self-contained true /p:PublishSingleFile=true /p:IncludeNativeLibrariesForSelfExtract=true /p:PublishReadyToRun=true",
    "start": "webpack serve --open",
    "dev:web": "concurrently \"dotnet run --project TaskFlow.csproj\" \"webpack --progress --watch\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win": "tauri build --target x86_64-pc-windows-msvc",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "files": [
    "dist"
  ],
  "typings": "./dist/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmed-Abdelbarr/Task_Flow.git"
  },
  "keywords": [
    "dotnet",
    "core",
    "taskflow"
  ],
  "author": "Ahmed Abdelbarr",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Ahmed-Abdelbarr/Task_Flow/issues"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-log": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router": "^7.14.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/webpack-env": "^1.18.8",
    "autoprefixer": "^10.5.0",
    "compression-webpack-plugin": "^12.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss-loader": "^8.2.1",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.7",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.2.4",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  }
}
